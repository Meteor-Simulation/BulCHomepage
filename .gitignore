# 환경 변수 파일 (보안)
.env
.env.prod
.env.local
.env.*.local

# 일회성 캠페인/메일 발송 작업 디렉토리 (개인정보 포함 가능)
.bulc-cli/

# 보안 키 파일 (sessionToken 개인키)
secrets/
*.pem
*.key
!keys/session_token_public_key.pem

# 로컬 개발용 설정 파일 (개인키 포함)
**/application-dev-local.yml
**/application-local.yml

# IDE
.idea/
*.iml
.vscode/

# 빌드 결과물
build/
dist/
target/
*.jar
*.war
.gradle/

# Gradle wrapper 는 위 *.jar 에 걸리면 안 된다 (MDP-844).
# 저장소에 없으면 새로 clone 한 환경에서 gradlew 가 GradleWrapperMain 을 찾지 못해
# 즉시 실패한다. CI 를 붙이면 곧바로 문제가 되므로 예외로 추적한다.
!backend/gradle/wrapper/gradle-wrapper.jar

# Node.js
node_modules/
npm-debug.log*

# 로그 파일
*.log
logs/

# Claude Code (agents 디렉토리는 추적)
.claude/*
!.claude/agents/

# OS 파일
.DS_Store
Thumbs.db

# Docker 볼륨 데이터 (로컬)
postgres_data/
nul
